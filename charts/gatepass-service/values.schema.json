{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gatepass-service values",
  "type": "object",
  "required": [
    "image",
    "basePath"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "registry",
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^sha-[0-9a-f]{7,40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "samplerArg": {
          "type": "string"
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "basePath": {
      "type": "string",
      "pattern": "^(/[a-z0-9-]+)?$",
      "description": "Route prefix. Empty only for a worker with no Ingress (its probes are at /livez, /readyz)."
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "not": {
            "required": [
              "cpu"
            ]
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "triggers": {
          "type": "array"
        },
        "authenticationRef": {
          "type": "string"
        }
      }
    },
    "internalService": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "pattern": "^$|^([a-z0-9-]+[.]){2,}[a-z]{2,}$"
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "array"
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "smokeTest": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "secretFiles": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/(var/run/secrets|etc)/[a-z0-9/-]+$"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fileName",
              "key"
            ],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "key": {
                "type": "string"
              },
              "property": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "zone": {
          "type": "string",
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        }
      }
    },
    "affinity": {
      "type": "object"
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "rollout": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(s|m)$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "failureLimit": {
              "type": "integer",
              "minimum": 0
            },
            "maxErrorRate": {
              "type": "string",
              "pattern": "^0(\\.[0-9]+)?$|^1$"
            },
            "maxP95Seconds": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "window": {
              "type": "string",
              "pattern": "^[0-9]+(s|m)$"
            },
            "region": {
              "type": "string"
            },
            "initialDelay": {
              "type": "string",
              "pattern": "^[0-9]+(s|m)$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "ingress"
        ]
      },
      "then": {
        "properties": {
          "basePath": {
            "minLength": 2
          }
        }
      }
    }
  ]
}
