{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gatepass-service values",
  "type": "object",
  "required": ["image", "basePath"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["registry", "repository", "tag", "digest"],
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^sha-[0-9a-f]{7,40}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "telemetry": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "endpoint": {"type": "string"}, "samplerArg": {"type": "string"}}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "basePath": {"type": "string", "pattern": "^/[a-z0-9-]+$"},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "replicaCount": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "limits": {"type": "object", "not": {"required": ["cpu"]}}
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "keda": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "triggers": {"type": "array"}}},
    "pdb": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 0}}},
    "ingress": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}}},
    "externalSecret": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "data": {"type": "array"}}},
    "migration": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "smokeTest": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "path": {"type": "string", "pattern": "^/"}, "attempts": {"type": "integer", "minimum": 1}}}
  }
}
